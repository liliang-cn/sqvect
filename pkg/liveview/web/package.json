{
  "name": "cortexdb-liveview-graph3d",
  "private": true,
  "description": "Builds assets/graph3d.js: 3d-force-graph, three and the bloom pass in one bundle, so the page loads one copy of three and needs no CDN.",
  "scripts": {
    "build": "esbuild entry.js --bundle --minify --format=iife --target=es2020 --legal-comments=none --outfile=../assets/graph3d.js"
  },
  "dependencies": {
    "3d-force-graph": "1.73.4",
    "three": "0.168.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "overrides": {
    "three": "0.168.0",
    "three-render-objects": "1.29.5",
    "three-forcegraph": "1.41.14"
  }
}
